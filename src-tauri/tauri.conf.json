{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speusis Downloader",
  "mainBinaryName": "Speusis Downloader",
  "identifier": "com.speusis.app",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Speusis Downloader",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/torrent.ico"
    ],
    "license": "license.txt",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "headerImage": "nsis-header.bmp",
        "sidebarImage": "nsis-sidebar.bmp",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "fileAssociations": []
  },
  "version": "0.1.0"
}